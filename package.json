{
  "name": "dsh-turn-notify",
  "version": "0.1.0",
  "description": "Turn-completion notifications for DeepSeek Harness on macOS, with a real UNUserNotificationCenter helper app",
  "type": "module",
  "main": "plugin/turn-notify.js",
  "exports": {
    ".": "./plugin/turn-notify.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "helper",
    "cordis.patch.yml",
    "install.sh",
    "uninstall.sh",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "macos",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senigius/dsh-turn-notify.git"
  },
  "homepage": "https://github.com/senigius/dsh-turn-notify#readme",
  "bugs": {
    "url": "https://github.com/senigius/dsh-turn-notify/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "build:helper": "bash helper/build.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
